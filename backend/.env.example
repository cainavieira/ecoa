# Copie para backend/.env e preencha. O .env não entra no git (ADR-0018).
ECOA_DB_URL=jdbc:postgresql://localhost:5433/ecoa
ECOA_DB_USUARIO=ecoa
ECOA_DB_SENHA=

# Chave privada RSA do token de acesso, em PKCS#8, codificada em base64 numa linha
# só (ADR-0008). Para gerar e acrescentar ao .env sem mostrar o valor, no Git Bash,
# na raiz do projeto:
#   echo "ECOA_JWT_CHAVE=$(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | grep -v -- '-----' | tr -d '\r\n')" >> backend/.env
ECOA_JWT_CHAVE=
